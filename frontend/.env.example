# =============================================================================
# WANDERLUXE FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
#
# IMPORTANT SECURITY RULE:
# Every variable prefixed with VITE_ is bundled into client-side JavaScript.
# NEVER place backend secrets (JWT_SECRET, MONGODB_URI, RAZORPAY_KEY_SECRET,
# Cloudinary API Secret, Brevo API Key, Twilio Auth Token) in this file!
#
# =============================================================================
# LOCAL DEVELOPMENT (Defaults)
# =============================================================================
#
# In local development, leave VITE_API_URL empty or set to /api.
# Vite's dev server automatically proxies /api to http://localhost:5000 (see vite.config.js).
VITE_API_URL=/api

# Optional local fallback. In production, Checkout dynamically uses orderData.key from the backend.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id

# Canonical Site URL (Local development)
VITE_SITE_URL=http://localhost:5173

# =============================================================================
# PRODUCTION (Vercel)
# =============================================================================
#
# Set these variables in the Vercel Project Dashboard:
# VITE_API_URL=https://wanderon-ashoksoft.onrender.com/api
# VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id
# VITE_SITE_URL=https://wanderon-ashok-soft.vercel.app
