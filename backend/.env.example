# =============================================================================
# WANDERLUXE BACKEND ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION)
# =============================================================================

# Server Port (Render sets this dynamically)
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.gud1uso.mongodb.net/wanderluxe?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_2026

# Frontend Client URL (For CORS Whitelist & Links)
FRONTEND_URL=https://wanderluxe.vercel.app

# Production Admin & Influencer Credentials
ADMIN_EMAIL=admin@wanderluxe.in
ADMIN_PASSWORD=your_secure_admin_password
INFLUENCER_EMAIL=influencer@wanderluxe.in
INFLUENCER_PASSWORD=your_secure_influencer_password

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Media Storage (Optional - Falls back to local memory if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Twilio WhatsApp Notifications (Optional - Falls back to simulation if empty)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
