# =============================================================================
# WANDERLUXE BACKEND ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION)
# =============================================================================

# Server Port (Render sets this dynamically)
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=

# Authentication secret (required, unique, 32+ characters; never commit the real value)
JWT_SECRET=

# Frontend Client URL (For CORS Whitelist & Links)
FRONTEND_URL=https://wanderluxe.vercel.app
ALLOWED_ORIGINS=https://wanderluxe.vercel.app
ALLOW_VERCEL_PREVIEWS=false

# One-off Staff provisioning inputs for: npm run staff:create
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=
STAFF_IS_ACTIVE=true

# Razorpay Payment Gateway (required for payment flows)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=

# Cloudinary Media Storage (required for production media mutations)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email (required for quotation recipient OTP verification)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WanderLuxe

# Twilio WhatsApp Notifications (optional; missing values report NOT_CONFIGURED)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
