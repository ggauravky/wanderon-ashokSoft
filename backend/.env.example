# =============================================================================
# WANDERLUXE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to backend/.env:
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# NEVER commit your actual .env file or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (REQUIRED)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED FOR REAL APP FLOWS)
# -----------------------------------------------------------------------------
# Obtain your development MongoDB connection string from your project maintainer.
# The server will start in dev mode without a DB, but DB-dependent features fail closed (503).
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Must be at least 32 characters long.
# Generate cross-platform with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# 4. CORS & CLIENT ACCESS (REQUIRED)
# -----------------------------------------------------------------------------
# In local development, frontend runs on port 5173:
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

# For production deployment (e.g. Render), set these to your live client domains:
# FRONTEND_URL=https://wanderluxe.vercel.app
# ALLOWED_ORIGINS=https://wanderluxe.vercel.app
# ALLOW_VERCEL_PREVIEWS=true

# -----------------------------------------------------------------------------
# 5. ONE-OFF STAFF PROVISIONING (OPTIONAL - Used by: npm run staff:create)
# -----------------------------------------------------------------------------
# Roles: super_admin | admin | sales | marketing
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=
STAFF_IS_ACTIVE=true

# -----------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (FEATURE-SPECIFIC)
# -----------------------------------------------------------------------------
# Required for payment creation, checkout, verification, and tests.
# Use TEST mode keys only in development (must start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 7. GOOGLE GEMINI AI (FEATURE-SPECIFIC)
# -----------------------------------------------------------------------------
# Required for AI Itinerary Planner and Quotation Smart Builder (server-side only).
GEMINI_API_KEY=
# Current stable primary model. The service has a controlled Flash-Lite fallback for transient outages.
GEMINI_MODEL=gemini-3.8-flash
# Anonymous, unlinked generated plans expire automatically after this many days (1-90).
AI_GUEST_ITINERARY_RETENTION_DAYS=7
# Low-cost quotation writing is isolated from the general AI Planner model.
QUOTATION_AI_MODEL=gemini-3.1-flash-lite
QUOTATION_AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Active Admin, Super Admin, or Sales account used only by the idempotent demo-data command.
DEMO_QUOTATION_STAFF_EMAIL=

# -----------------------------------------------------------------------------
# 8. CLOUDINARY MEDIA STORAGE (FEATURE-SPECIFIC)
# -----------------------------------------------------------------------------
# In development, image uploads fall back to local disk storage (./uploads) if not set.
# Required in production for media upload mutations.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# 9. BREVO TRANSACTIONAL EMAIL (FEATURE-SPECIFIC)
# -----------------------------------------------------------------------------
# Required for Quotation recipient email delivery & OTP verification workflows.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WanderLuxe

# -----------------------------------------------------------------------------
# 10. TWILIO WHATSAPP NOTIFICATIONS (OPTIONAL)
# -----------------------------------------------------------------------------
# If unconfigured, notification services return status: 'NOT_CONFIGURED'.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
