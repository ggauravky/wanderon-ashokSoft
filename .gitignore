# Root GitIgnore for Monorepo (Frontend & Backend)

# Node Dependencies
**/node_modules/

# Build & Dist Outputs
**/dist/
**/dist-ssr/
**/build/
/tmp/pdfs/

# Environment Files & Secrets
**/.env
**/.env.local
**/.env.*.local

# Logs
**/logs/
**/*.log

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
