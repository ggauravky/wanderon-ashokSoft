# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
.nvmrc text eol=lf
.node-version text eol=lf
.gitignore text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
